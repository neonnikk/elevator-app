# HTTP порт приложения (фронтенд)
APP_PORT=3017

# Пути хранения данных (по умолчанию — папки рядом с docker-compose.yml)
# Можно указать абсолютный путь, например: /mnt/storage/liftapp/data
DATA_PATH=./data
BACKUP_PATH=./backups

# JWT секрет — ОБЯЗАТЕЛЬНО измените! Минимум 32 символа
JWT_SECRET=your-very-secret-key-change-this-min-32-chars

# Часовой пояс для уведомлений ТО (важно для cron и дат)
TZ=Europe/Moscow

# Путь к файлу ошибок (внутри контейнера, хранится в volume /data)
LOG_PATH=/data/error.log

# Telegram уведомления (опционально)
# Глобальный чат — получает все уведомления
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
